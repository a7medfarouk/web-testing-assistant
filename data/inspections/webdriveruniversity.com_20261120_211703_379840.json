{
  "about_locators": {
    "what_locators_are": "Each element has a 'locators' list: the candidate Playwright locators found for that element, best first. Every candidate was run against the live page, so 'match_count' is what was actually observed, not a guess. Candidates that matched nothing were dropped. An empty list means no usable locator was found.",
    "fields": {
      "strategy": "How the locator finds the element: test_id (data-testid), role (ARIA role + accessible name), label (form label text), placeholder, text (visible text, only for elements with no ARIA role), css_id (id attribute), css_data_test / css_data_cy / css_data_qa (other test attributes), css_name (name attribute), css_href (link target), css_path (position in the page, last resort).",
      "code": "The Playwright (Python) call that builds the locator, e.g. page.<code>.",
      "match_count": "How many elements on the WHOLE page this locator matched when scanned.",
      "unique": "true when match_count is exactly 1. Only a unique locator is safe for an action (click, fill) because it can only hit this one element. false means it also matches other elements and would be ambiguous.",
      "stable": "true when the locator relies on meaningful page content (test id, role/name, label, id, ...) and should survive layout changes. false (only css_path) means it relies on the element's position in the page, so adding, removing or moving elements can break it or make it point at the wrong element."
    },
    "how_to_choose": "Prefer the first locator with unique=true and stable=true. If only a stable=false locator is unique, treat it as fragile and ask the tester to confirm."
  },
