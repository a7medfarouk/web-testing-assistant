# Copy to .env to override defaults (all optional).

# Model to run (also what gets pulled / warmed up).
OLLAMA_MODEL=qwen2.5:7b-instruct

# Folder that holds the model store ("models/" lives inside it).
# Default is ~/.ollama, which is where the Ollama desktop app / CLI keeps models
# on macOS, Windows (%USERPROFILE%\.ollama) and Linux user installs.
# Linux systemd service install:  OLLAMA_HOME=/usr/share/ollama/.ollama
# Windows: set this explicitly, e.g. OLLAMA_HOME=C:/Users/you/.ollama
#OLLAMA_HOME=

#BACKEND_PORT=8000
#OLLAMA_PORT=11435
